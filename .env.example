# Credentials stay local. Enable Message Content Intent in the Discord Developer Portal.
DISCORD_BOT_TOKEN=
OPENAI_API_KEY=
# Explicit allowlist; no guild is enabled by default.
ANIMA_ALLOWED_GUILD_IDS=
ANIMA_DM_ENABLED=false
# Start text-only. Optional examples: echo,voice or voice,web_search.
ANIMA_PLUGINS=
# Trusted external application package (requires installation and restart).
# ANIMA_PLUGIN_NAMESPACE=my_bot.plugins
ANIMA_ENABLE_WEB_SEARCH=false
# Optional: ANIMA_ROOT=config; ANIMA_STATE_ROOT=../state (relative to ANIMA_ROOT)
# Optional: ANIMA_DASHBOARD_HOST=127.0.0.1; ANIMA_DASHBOARD_PORT=8765
# Set a long ANIMA_DASHBOARD_ADMIN_TOKEN to enable configuration editing.
# Optional bounded-decision provider (default: responses). Thresholds apply to decisions.
# ANIMA_DECISION_BACKEND=decisions
# ANIMA_DECISION_MODEL=gpt-6-luna
# ANIMA_DECISION_ADDRESS_THRESHOLD=0.9
# ANIMA_DECISION_SPEECH_THRESHOLD=0.95
# ANIMA_DECISION_REACTION_THRESHOLD=0.9
# Optional diagnostic comparison; disabled unless explicitly selected.
# ANIMA_DECISION_SHADOW_BACKEND=decisions
# ANIMA_DECISION_SHADOW_DAILY_LIMIT=10
